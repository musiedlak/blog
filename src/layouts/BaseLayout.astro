---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Jan Musiedlak" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline defer src="https://api.pirsch.io/pa.js" id="pianjs" data-code="8QP24byp7s89Bxe1OoWKM4X5Ep1opV4T"></script>
  </head>
  <body class={wide ? 'layout-wide' : undefined}>
    <header class="site-header">
      <div class="wrap site-masthead">
        <div class="site-identity">
          <a class="site-title" href="/">Field Notes</a>
        </div>
        <a class="site-parent" href="https://janmusiedlak.de">Jan Musiedlak <span aria-hidden="true">&#8599;</span></a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer-row">
        <span>© {year} Jan Musiedlak</span>
        <nav class="site-footer-links">
          <a href="https://janmusiedlak.de/impressum.html">Impressum</a>
          <a href="https://janmusiedlak.de/datenschutz.html">Datenschutz</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
